generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id             Int         @id @default(autoincrement())
  name           String?
  domain         String
  username       String      @unique
  password       String
  paymentGateway String
  address        String
  phone          String?
  themeColor     String      @default("#f97316")
  secondaryColor String      @default("#7c3aed")
  accentColor    String      @default("#f59e0b")
  fontFamily     String      @default("manrope")
  cardStyle      String      @default("rounded")
  logoUrl        String?
  coverUrl       String?
  cuisines       String?
  rating         Float?
  ratingCount    Int?
  // Set manually by SaaS support staff when onboarding a restaurant (admin
  // panel). Nullable — restaurants without coordinates are excluded from the
  // mobile app's distance-sorted "nearby" listing until set.
  latitude       Float?
  longitude      Float?
  // Fallback grouping for the mobile app's "nearby" list when a customer's
  // GPS is unavailable/denied — they pick a city instead, and this filters
  // to restaurants tagged with it (see GET /api/restaurant/nearby?cityId=).
  cityId         Int?
  city           City?       @relation(fields: [cityId], references: [id])
  // PhonePe merchant credentials — per-restaurant so each tenant's payments go
  // to their OWN merchant account, not a single shared one. phonepeSaltKey is
  // write-only from the API's perspective (never included in any GET select).
  // Null merchantId/saltKey means this restaurant has no gateway configured
  // yet — checkout runs in per-restaurant dev mode (order placed, no real charge).
  phonepeMerchantId String?
  phonepeSaltKey    String?
  phonepeSaltIndex  String?     @default("1")
  phonepeSandbox    Boolean     @default(true)
  pickupEnabled  Boolean     @default(false)
  deliveryEnabled Boolean    @default(true)
  isOpen         Boolean     @default(true)
  // Kitchen SLA thresholds (minutes) — Analytics + Kitchen Display flag a
  // PREPARING order "slow" past slaWarnMinutes and "over SLA" past slaCritMinutes.
  slaWarnMinutes Int         @default(8)
  slaCritMinutes Int         @default(15)
  refreshToken   String?
  menu           MenuItem[]
  orders         Order[]
  category       Category[]
  waiters        Waiter[]
  dailyCounters  DailyCounter[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  isActive       Boolean
}

model Category {
  id           Int        @id @default(autoincrement())
  name         String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  menuItems    MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  isActive     Boolean
}

model MenuItem {
  id              Int               @id @default(autoincrement())
  name            String
  description     String?
  price           Float
  available       Boolean
  isVeg           Boolean?
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id])
  restaurantId    Int
  category        Category?         @relation(fields: [categoryId], references: [id])
  categoryId      Int?
  imageUrl        String?
  position        Int               @default(0)
  optionGroups    OptionGroup[]
  orderItems      OrderItem[]
  menuItemHistory MenuItemHistory[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  isActive        Boolean
}

model OptionGroup {
  id         Int      @id @default(autoincrement())
  title      String
  required   Boolean
  multiple   Boolean
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId Int
  options    Option[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Option {
  id            Int         @id @default(autoincrement())
  name          String
  priceDelta    Float
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id])
  optionGroupId Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Order {
  id                   Int                  @id @default(autoincrement())
  restaurant           Restaurant           @relation(fields: [restaurantId], references: [id])
  restaurantId         Int
  user                 User?                @relation(fields: [userId], references: [id])
  userId               Int?
  waiter               Waiter?              @relation(fields: [waiterId], references: [id])
  waiterId             Int?
  dailyOrderNumber     Int?
  idempotencyKey       String?              @unique
  guestName            String?
  guestVehicle         String?
  totalAmount          Float
  status               OrderStatus
  paymentMethod        PaymentMethod        @default(COD)
  deliveryCode         String?              @unique
  deviceKey            String?
  deliveryInstructions String
  orderItems           OrderItem[]
  orderStatusHistory   OrderStatusHistory[]
  merchantTransaction  MerchantTransaction[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model OrderItem {
  id         Int               @id @default(autoincrement())
  order      Order             @relation(fields: [orderId], references: [id])
  orderId    Int
  menuItem   MenuItem?         @relation(fields: [menuItemId], references: [id])
  menuItemId Int?
  name       String
  unitPrice  Float
  finalPrice Float
  quantity   Int
  options    OrderItemOption[]
  createdAt  DateTime          @default(now())
}

model OrderItemOption {
  id          Int       @id @default(autoincrement())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  orderItemId Int
  name        String
  priceDelta  Float
}

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  orderId   Int
  status    String
  updatedAt DateTime @default(now())
  updatedBy String?
  order     Order    @relation(fields: [orderId], references: [id])
}

model MenuItemHistory {
  id          Int      @id @default(autoincrement())
  menuItemId  Int
  name        String
  description String?
  price       Decimal  @default(0.0) @db.Decimal(10, 2)
  available   Boolean
  changedAt   DateTime @default(now())
  changedBy   String?
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  isActive    Boolean
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
  NOT_FULFILLED
}

// Per-restaurant, per-calendar-day counter backing Order.dailyOrderNumber.
// `date` is a "YYYY-MM-DD" key (IST) — incremented atomically on order creation.
model DailyCounter {
  id           Int        @id @default(autoincrement())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  date         String
  lastNumber   Int        @default(0)

  @@unique([restaurantId, date])
}

enum PaymentMethod {
  COD
  PHONEPE
}

model MerchantTransaction {
  id      Int    @id @default(autoincrement())
  orderId Int
  txnId   String
  status  String
  order   Order  @relation(fields: [orderId], references: [id])
}

// Auto-created on first order keyed by phone number; upgraded to full account on registration
model User {
  id           Int           @id @default(autoincrement())
  customerName String
  phoneNumber  String        @unique
  username     String?       @unique
  password     String?
  orders       Order[]
  vehicles     UserVehicle[]
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// A user's saved vehicles (one user -> many vehicles), used for prefill on later orders
model UserVehicle {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  vehicleNo  String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @updatedAt

  @@unique([userId, vehicleNo])
}

// Delivery staff of a restaurant. Scan orders via a 1-day token (no login required).
model Waiter {
  id           Int        @id @default(autoincrement())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  name         String
  phone        String?
  isActive     Boolean    @default(true)
  deletedAt    DateTime?
  orders       Order[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}


// Fallback grouping for the mobile app's homepage when a customer's GPS is
// unavailable/denied — they pick a city instead of getting distance-sorted
// results. Seeded with a fixed list (see prisma/seed.js); no admin UI yet.
model City {
  id          Int          @id @default(autoincrement())
  name        String
  state       String?
  isActive    Boolean      @default(true)
  restaurants Restaurant[]
}
