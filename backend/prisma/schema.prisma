generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Restaurant {
  id             Int         @id @default(autoincrement())
  name           String?
  // URL-safe public identifier — the mobile app serves a restaurant at both
  // /restaurant/<id> and the friendlier /<slug> ("spice-garden"), which is what
  // QR codes and shared links point at. Nullable so a restaurant created before
  // this existed (or one whose name yields no usable slug) still works on its
  // numeric URL; unique because it has to resolve to exactly one tenant.
  slug           String?     @unique
  domain         String
  username       String      @unique
  password       String
  paymentGateway String
  address        String
  phone          String?
  themeColor     String      @default("#f97316")
  secondaryColor String      @default("#7c3aed")
  accentColor    String      @default("#f59e0b")
  fontFamily     String      @default("manrope")
  cardStyle      String      @default("rounded")
  logoUrl        String?
  coverUrl       String?
  cuisines       String?
  rating         Float?
  ratingCount    Int?
  // Set manually by SaaS support staff when onboarding a restaurant (admin
  // panel). Nullable — restaurants without coordinates are excluded from the
  // mobile app's distance-sorted "nearby" listing until set.
  latitude       Float?
  longitude      Float?
  // Fallback grouping for the mobile app's "nearby" list when a customer's
  // GPS is unavailable/denied — they pick a city instead, and this filters
  // to restaurants tagged with it (see GET /api/restaurant/nearby?cityId=).
  cityId         Int?
  city           City?       @relation(fields: [cityId], references: [id])
  // PhonePe merchant credentials — per-restaurant so each tenant's payments go
  // to their OWN merchant account, not a single shared one. phonepeSaltKey is
  // write-only from the API's perspective (never included in any GET select).
  // Null merchantId/saltKey means this restaurant has no gateway configured
  // yet — checkout runs in per-restaurant dev mode (order placed, no real charge).
  phonepeMerchantId String?
  phonepeSaltKey    String?
  phonepeSaltIndex  String?     @default("1")
  phonepeSandbox    Boolean     @default(true)
  pickupEnabled  Boolean     @default(false)
  deliveryEnabled Boolean    @default(true)
  isOpen         Boolean     @default(true)
  // Opening hours, "HH:MM" 24h IST (see utils/businessHours.js). Customers can
  // only order inside them, and they define the business day: when closing is
  // after midnight the day ends at closing, not at midnight. Both null = no
  // hours (always open, midnight-to-midnight day).
  openingTime    String?
  closingTime    String?
  // Tax & compliance (dashboard Settings). GST is only charged/shown when a
  // GSTIN is set and gstRate > 0 — an unregistered business can't collect it.
  // Menu prices always include GST, split out for display on the bill. See
  // utils/gst.js.
  gstin            String?
  gstRate          Float    @default(0)
  // Vestigial: prices are ALWAYS inclusive of GST now, and nothing reads this.
  // Order.pricesIncludeGst below is different — that is a per-order snapshot and
  // must stay. Kept rather than dropped so the column can be revived without a
  // data migration if the choice is ever reinstated. See utils/gst.js.
  pricesIncludeGst Boolean  @default(true)
  // 14-digit FSSAI licence/registration number, shown on the menu and bills.
  fssaiLicense     String?
  // Seller identity for this restaurant's own policy pages (/<slug>/legal/…).
  // The restaurant is the merchant of record — payments go to its own PhonePe
  // account — so its legal name and support contact appear there, while the
  // platform's grievance officer stays in the mobile app's lib/legal.js.
  legalName        String?
  supportEmail     String?
  supportPhone     String?
  // Kitchen SLA thresholds (minutes) — Analytics + Kitchen Display flag a
  // PREPARING order "slow" past slaWarnMinutes and "over SLA" past slaCritMinutes.
  slaWarnMinutes Int         @default(8)
  slaCritMinutes Int         @default(15)
  // Whether a "Served in Car" customer MUST pick one of parkingSpots at
  // checkout. Only takes effect once the restaurant has at least one active
  // spot — with none configured the app never asks.
  parkingSpotRequired Boolean @default(true)
  refreshToken   String?
  menu           MenuItem[]
  orders         Order[]
  category       Category[]
  waiters        Waiter[]
  parkingSpots   ParkingSpot[]
  venues         VenueRestaurant[]
  dailyCounters  DailyCounter[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  isActive       Boolean
}

model Category {
  id           Int        @id @default(autoincrement())
  name         String
  // Display order of the category itself, set by the restaurant in the
  // dashboard (drag to reorder) — mirrors MenuItem.position, which orders
  // items *within* a category. Every read that feeds a menu sorts by this,
  // then by id so pre-existing categories (all position 0) keep a stable order.
  position     Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  menuItems    MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  isActive     Boolean
}

model MenuItem {
  id              Int               @id @default(autoincrement())
  name            String
  description     String?
  price           Float
  available       Boolean
  isVeg           Boolean?
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id])
  restaurantId    Int
  category        Category?         @relation(fields: [categoryId], references: [id])
  categoryId      Int?
  imageUrl        String?
  position        Int               @default(0)
  optionGroups    OptionGroup[]
  orderItems      OrderItem[]
  menuItemHistory MenuItemHistory[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  isActive        Boolean
}

model OptionGroup {
  id         Int      @id @default(autoincrement())
  title      String
  required   Boolean
  multiple   Boolean
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  menuItemId Int
  options    Option[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Option {
  id            Int         @id @default(autoincrement())
  name          String
  priceDelta    Float
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id])
  optionGroupId Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Order {
  id                   Int                  @id @default(autoincrement())
  restaurant           Restaurant           @relation(fields: [restaurantId], references: [id])
  restaurantId         Int
  user                 User?                @relation(fields: [userId], references: [id])
  userId               Int?
  waiter               Waiter?              @relation("DeliveredOrders", fields: [waiterId], references: [id])
  waiterId             Int?
  // Waiter who said "I'm taking this" on a READY order in the waiter app, so
  // two waiters don't walk to the same car. waiterId is still only set when
  // the delivery scan actually completes the order.
  claimedBy            Waiter?              @relation("ClaimedOrders", fields: [claimedByWaiterId], references: [id])
  claimedByWaiterId    Int?
  claimedAt            DateTime?
  dailyOrderNumber     Int?
  idempotencyKey       String?              @unique
  guestName            String?
  guestVehicle         String?
  // Name of the parking spot the customer picked, copied at order time (like
  // OrderItem.name) so renaming or removing a spot never rewrites past orders.
  parkingSpot          String?
  // GST as applied when the order was placed (snapshot, like item prices), so
  // changing tax settings later never rewrites past invoices. All null on
  // orders from before GST support / restaurants without a GSTIN.
  subtotalAmount       Float?     // sum of item prices as listed on the menu
  gstRate              Float?
  gstAmount            Float?
  gstin                String?
  pricesIncludeGst     Boolean?
  totalAmount          Float      // what the customer paid (incl. GST)
  status               OrderStatus
  paymentMethod        PaymentMethod        @default(COD)
  deliveryCode         String?              @unique
  deviceKey            String?
  deliveryInstructions String
  orderItems           OrderItem[]
  orderStatusHistory   OrderStatusHistory[]
  merchantTransaction  MerchantTransaction[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model OrderItem {
  id         Int               @id @default(autoincrement())
  order      Order             @relation(fields: [orderId], references: [id])
  orderId    Int
  menuItem   MenuItem?         @relation(fields: [menuItemId], references: [id])
  menuItemId Int?
  name       String
  unitPrice  Float
  finalPrice Float
  quantity   Int
  options    OrderItemOption[]
  createdAt  DateTime          @default(now())
}

model OrderItemOption {
  id          Int       @id @default(autoincrement())
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  orderItemId Int
  name        String
  priceDelta  Float
}

model OrderStatusHistory {
  id        Int      @id @default(autoincrement())
  orderId   Int
  status    String
  updatedAt DateTime @default(now())
  updatedBy String?
  order     Order    @relation(fields: [orderId], references: [id])
}

model MenuItemHistory {
  id          Int      @id @default(autoincrement())
  menuItemId  Int
  name        String
  description String?
  price       Decimal  @default(0.0) @db.Decimal(10, 2)
  available   Boolean
  changedAt   DateTime @default(now())
  changedBy   String?
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  isActive    Boolean
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
  NOT_FULFILLED
}

// Per-restaurant, per-calendar-day counter backing Order.dailyOrderNumber.
// `date` is a "YYYY-MM-DD" key (IST) — incremented atomically on order creation.
model DailyCounter {
  id           Int        @id @default(autoincrement())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  date         String
  lastNumber   Int        @default(0)

  @@unique([restaurantId, date])
}

enum PaymentMethod {
  COD
  PHONEPE
}

model MerchantTransaction {
  id      Int    @id @default(autoincrement())
  orderId Int
  txnId   String
  status  String
  order   Order  @relation(fields: [orderId], references: [id])
}

// Auto-created on first order keyed by phone number; upgraded to full account on registration
model User {
  id           Int           @id @default(autoincrement())
  customerName String
  phoneNumber  String        @unique
  username     String?       @unique
  password     String?
  orders       Order[]
  vehicles     UserVehicle[]
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

// A user's saved vehicles (one user -> many vehicles), used for prefill on later orders
model UserVehicle {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  vehicleNo  String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @updatedAt

  @@unique([userId, vehicleNo])
}

// Delivery staff of a restaurant. Scan orders via a 1-day token (no login required).
model Waiter {
  id           Int        @id @default(autoincrement())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  name         String
  phone        String?
  isActive     Boolean    @default(true)
  deletedAt    DateTime?
  orders       Order[]    @relation("DeliveredOrders")
  claimedOrders Order[]   @relation("ClaimedOrders")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}


// Where a "Served in Car" customer can say they are parked ("Basement B2",
// "Gate 3 – Row A"). Managed by the restaurant from dashboard Settings; the
// ordering app shows the active ones as a dropdown at checkout. Removing a
// spot only deactivates it — orders keep their own copy of the name.
model ParkingSpot {
  id           Int        @id @default(autoincrement())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  restaurantId Int
  name         String
  position     Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([restaurantId])
}

// Fallback grouping for the mobile app's homepage when a customer's GPS is
// unavailable/denied — they pick a city instead of getting distance-sorted
// results. Seeded with a fixed list (see prisma/seed.js); no admin UI yet.
model City {
  id          Int          @id @default(autoincrement())
  name        String
  state       String?
  isActive    Boolean      @default(true)
  restaurants Restaurant[]
  venues      Venue[]
}

// What kind of place a Venue is. Purely presentational — it picks the icon and
// the label ("14 outlets · Campus") in the ordering app, and groups the admin
// list. No behaviour hangs off it; membership rules live in VenueMembership.
enum VenueType {
  UNIVERSITY
  MALL
  TECH_PARK
  OFFICE_PARK
  HOSPITAL
  AIRPORT
  STADIUM
  RESIDENTIAL
  OTHER
}

// How a Venue decides which restaurants appear on it.
//   STRICT    — only restaurants an admin explicitly mapped. A university must
//               never list the dhaba across the road just because it is 400 m
//               from the gate.
//   INCLUSIVE — mapped restaurants UNION anything inside includeRadiusM of the
//               venue centre. For a mall or market square ("City Square") where
//               the surrounding street food genuinely is part of the place.
enum VenueMembership {
  STRICT
  INCLUSIVE
}

// A place that clubs several restaurants together — a university campus, a
// mall, a tech park. The ordering app auto-switches into a venue when the
// customer's GPS lands inside it, and every venue is also a shareable
// destination of its own at /at/<slug>.
model Venue {
  id             Int               @id @default(autoincrement())
  name           String
  // URL-safe public identifier — the ordering app serves a venue at
  // /at/<slug>. Unlike Restaurant.slug this is NOT nullable: a venue with no
  // web address has no page to auto-detect a customer into, which is the
  // entire point of the model. Lives under /at/ so venue and restaurant slugs
  // occupy separate namespaces and can never collide.
  slug           String            @unique
  type           VenueType         @default(OTHER)
  description    String?
  logoUrl        String?
  coverUrl       String?
  address        String?
  // Required, unlike Restaurant's nullable pair — see the slug note above.
  latitude       Float
  longitude      Float
  // How close a customer has to be before the app switches into this venue.
  // A spread-out campus wants ~900, a single mall building ~150. Deliberately
  // NOT the same number as includeRadiusM: this answers "is the customer
  // here?", that one answers "which restaurants count?".
  detectRadiusM  Int               @default(500)
  membershipMode VenueMembership   @default(STRICT)
  // Only ever read when membershipMode is INCLUSIVE. Null on a STRICT venue.
  includeRadiusM Int?
  cityId         Int?
  city           City?             @relation(fields: [cityId], references: [id])
  restaurants    VenueRestaurant[]
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([isActive])
}

// Explicit membership of a restaurant in a venue (many-to-many: a café can sit
// in both a mall and the tech park the mall belongs to). An INCLUSIVE venue
// shows these PLUS whatever falls inside its radius; a STRICT venue shows only
// these. Venue analytics counts only these rows in both modes — attributing a
// neighbouring restaurant's revenue to a mall it isn't part of would be wrong.
model VenueRestaurant {
  id           Int        @id @default(autoincrement())
  venue        Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  venueId      Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  restaurantId Int
  // Admin-controlled ordering on the venue page, mirroring Category.position.
  position     Int        @default(0)
  createdAt    DateTime   @default(now())

  @@unique([venueId, restaurantId])
  @@index([restaurantId])
}
